{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "tools": [
    {
      "name": "list_files",
      "description": "List files/directories under a repository path.",
      "allowed_modes": ["ask", "code"],
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "path": { "type": "string", "default": "/" },
          "recursive": { "type": "boolean", "default": false }
        },
        "required": ["project_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "type": { "type": "string", "enum": ["file", "directory"] },
                "size": { "type": "integer" }
              },
              "required": ["path", "type"],
              "additionalProperties": false
            }
          }
        },
        "required": ["entries"],
        "additionalProperties": false
      }
    },
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from repository.",
      "allowed_modes": ["ask", "code"],
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "path": { "type": "string" }
        },
        "required": ["project_id", "path"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      }
    },
    {
      "name": "write_file",
      "description": "Write file content to repository (code mode only).",
      "allowed_modes": ["code"],
      "requires_checkpoint": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "path": { "type": "string" },
          "content": { "type": "string" },
          "commit_message": { "type": "string" }
        },
        "required": ["project_id", "path", "content"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "bytes_written": { "type": "integer" },
          "git_commit_sha": { "type": "string" }
        },
        "required": ["path", "bytes_written"],
        "additionalProperties": false
      }
    },
    {
      "name": "create_checkpoint",
      "description": "Create a restore checkpoint tied to a Git commit/sha.",
      "allowed_modes": ["code"],
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "label": { "type": "string" },
          "scope": { "type": "string", "enum": ["run", "manual"], "default": "run" }
        },
        "required": ["project_id", "label"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "checkpoint_id": { "type": "string" },
          "git_commit_sha": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["checkpoint_id", "git_commit_sha", "created_at"],
        "additionalProperties": false
      }
    },
    {
      "name": "list_checkpoints",
      "description": "List available checkpoints for a project.",
      "allowed_modes": ["ask", "code"],
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        },
        "required": ["project_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "checkpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "checkpoint_id": { "type": "string" },
                "label": { "type": "string" },
                "git_commit_sha": { "type": "string" },
                "created_at": { "type": "string", "format": "date-time" }
              },
              "required": ["checkpoint_id", "label", "git_commit_sha", "created_at"],
              "additionalProperties": false
            }
          }
        },
        "required": ["checkpoints"],
        "additionalProperties": false
      }
    },
    {
      "name": "diff_from_checkpoint",
      "description": "Show diff between current state and a checkpoint.",
      "allowed_modes": ["ask", "code"],
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "checkpoint_id": { "type": "string" }
        },
        "required": ["project_id", "checkpoint_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "files_changed": { "type": "integer" },
          "diff": { "type": "string" }
        },
        "required": ["summary", "files_changed", "diff"],
        "additionalProperties": false
      }
    },
    {
      "name": "return_state",
      "description": "Restore repository to checkpoint.",
      "allowed_modes": ["code"],
      "requires_confirmation": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "checkpoint_id": { "type": "string" },
          "mode": { "type": "string", "enum": ["soft", "hard"], "default": "soft" },
          "reason": { "type": "string" }
        },
        "required": ["project_id", "checkpoint_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "restored": { "type": "boolean" },
          "from_commit_sha": { "type": "string" },
          "to_commit_sha": { "type": "string" },
          "rollback_event_id": { "type": "string" }
        },
        "required": ["restored", "to_commit_sha"],
        "additionalProperties": false
      }
    }
  ]
}